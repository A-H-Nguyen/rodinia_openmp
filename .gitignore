data/
others/
*.a
*.o
*.bc
*.csv
*.out
*.txt
*.log

# Lifter sidecars. compile-benchmarks.py sweeps these from the source tree
# between configurations -- no benchmark's `make clean` knows about them, and
# leaving them behind attributes one configuration's intermediates to every
# other one in the size metric.
*.mlirbc
*.xmo.mlir
*.imports

# LLVM IR emitted by csrc/. Regenerated by `make`; never committed.
*.ll


# cfd writes its results next to its source, and every run overwrites them, so
# tracking them meant the tree was dirty after any run of the benchmark. They
# are computed output, not reference data -- the harness compared one arm's
# against another arm's, never against a committed copy.
csrc/cfd/density
csrc/cfd/density_energy
csrc/cfd/momentum
